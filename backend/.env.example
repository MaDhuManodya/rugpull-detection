# ============================================================
# .env.example — Environment Variables Template
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Application ───────────────────────────────────────────────
APP_NAME="Rugpull Detection API"
APP_VERSION="0.1.0"
APP_ENV=development          # development | staging | production
DEBUG=true
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHARACTER_SECRET
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=rugpull
POSTGRES_PASSWORD=rugpull_secret
POSTGRES_DB=rugpull_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://rugpull:rugpull_secret@localhost:5432/rugpull_db
DATABASE_URL_SYNC=postgresql+psycopg2://rugpull:rugpull_secret@localhost:5432/rugpull_db

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret
REDIS_URL=redis://:redis_secret@localhost:6379/0

# ── Celery ────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://:redis_secret@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:redis_secret@localhost:6379/2

# ── Blockchain APIs ───────────────────────────────────────────
# Etherscan (Ethereum Mainnet)
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY_HERE

# BscScan (BNB Smart Chain)
BSCSCAN_API_KEY=YOUR_BSCSCAN_API_KEY_HERE

# Alchemy (RPC endpoints)
ALCHEMY_ETH_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ALCHEMY_BSC_URL=https://bnb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Infura (fallback RPC)
INFURA_PROJECT_ID=YOUR_INFURA_PROJECT_ID

# DeFi Llama (no key required — public)
DEFI_LLAMA_BASE_URL=https://api.llama.fi

# ── API Rate Limits ───────────────────────────────────────────
ETHERSCAN_RATE_LIMIT=5       # requests per second
BSCSCAN_RATE_LIMIT=5
ALCHEMY_RATE_LIMIT=10

# ── Machine Learning ──────────────────────────────────────────
MODEL_DIR=/app/trained_models
DEVICE=cpu                   # cpu | cuda | mps

# GATv2 Hyperparameters (to be overridden per thesis Chapter 5)
GATV2_HIDDEN_DIM=64
GATV2_NUM_HEADS=4
GATV2_NUM_LAYERS=2
GATV2_DROPOUT=0.1

# TGN Hyperparameters (to be overridden per thesis Chapter 5)
TGN_MEMORY_DIM=172
TGN_NODE_EMBEDDING_DIM=100
TGN_TIME_EMBEDDING_DIM=100
TGN_NUM_HEADS=2
TGN_DROPOUT=0.1

# Training
LEARNING_RATE=0.0001
BATCH_SIZE=200
MAX_EPOCHS=100
EARLY_STOPPING_PATIENCE=10

# ── Flower (Celery Monitor) ───────────────────────────────────
FLOWER_USER=admin
FLOWER_PASSWORD=flower_secret

# ── PgAdmin ───────────────────────────────────────────────────
PGADMIN_EMAIL=admin@rugpull.dev
PGADMIN_PASSWORD=pgadmin_secret

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json              # json | text
